{
  "name": "prontuario-pet/api",
  "description": "API central do Prontuário Pet",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo_pgsql": "*",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "google/apiclient": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {"Tests\\": "tests/"}
  },
  "scripts": {
    "post-autoload-dump": ["@php artisan package:discover --ansi"],
    "test": ["@php artisan config:clear", "@php vendor/bin/phpunit"]
  },
  "config": {"sort-packages": true},
  "prefer-stable": true
}
